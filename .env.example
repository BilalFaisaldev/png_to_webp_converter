PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/png_to_webp_db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_AUTH_TOKEN=your_admin_secret_token

# Real Email Delivery Configuration (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
